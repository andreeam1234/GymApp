@model GymClassViewModel
@{
    ViewData["Title"] = Model.Name;
}

<div class="mb-4">
    <a asp-controller="GymClasses" asp-action="Index" class="btn btn-link ps-0">&larr; Inapoi la clase</a>
    <h2>@Model.Name</h2>
    <span class="badge bg-secondary">@Model.Category</span>
    <p class="mt-3">@Model.Description</p>
    <p class="text-muted">Durata: @Model.DurationMinutes minute</p>

    @if (User.IsInRole("Admin"))
    {
        <a asp-controller="GymClasses" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">Editeaza</a>
        <a asp-controller="GymClasses" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">Sterge</a>
    }
</div>

<h4>Sesiuni programate</h4>
@if (!Model.Sessions.Any())
{
    <p class="text-muted">Nu exista sesiuni programate momentan pentru aceasta clasa.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Data si ora</th>
                <th>Trainer</th>
                <th>Sala</th>
                <th>Locuri</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var session in Model.Sessions.OrderBy(s => s.StartTime))
            {
                <tr>
                    <td>@session.StartTime.ToString("dd MMM yyyy, HH:mm")</td>
                    <td>@session.TrainerName</td>
                    <td>@session.Room</td>
                    <td>@session.EnrolledCount / @session.Capacity</td>
                </tr>
            }
        </tbody>
    </table>
    <p class="text-muted small">
        Pentru rezervari, foloseste widget-ul "Calendarul meu" din pagina de profil.
    </p>
}
