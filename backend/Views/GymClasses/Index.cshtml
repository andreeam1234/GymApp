@model List<GymClassViewModel>
@{
    ViewData["Title"] = "Clase";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Clase disponibile</h2>
    @if (User.IsInRole("Admin"))
    {
        <a asp-controller="GymClasses" asp-action="Create" class="btn btn-success">+ Clasa noua</a>
    }
</div>

<div class="row">
    @foreach (var gymClass in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">@gymClass.Name</h5>
                    <h6 class="card-subtitle mb-2 text-muted">@gymClass.Category</h6>
                    <p class="card-text">@gymClass.Description</p>
                    <p class="text-muted small">
                        Durata: @gymClass.DurationMinutes min &middot; @gymClass.SessionCount sesiuni programate
                    </p>
                </div>
                <div class="card-footer bg-transparent d-flex justify-content-between">
                    <a asp-controller="GymClasses" asp-action="Details" asp-route-id="@gymClass.Id"
                       class="btn btn-outline-primary btn-sm">Detalii</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <span>
                            <a asp-controller="GymClasses" asp-action="Edit" asp-route-id="@gymClass.Id"
                               class="btn btn-outline-secondary btn-sm">Editeaza</a>
                            <a asp-controller="GymClasses" asp-action="Delete" asp-route-id="@gymClass.Id"
                               class="btn btn-outline-danger btn-sm">Sterge</a>
                        </span>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (totalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" asp-controller="GymClasses" asp-action="Index" asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
