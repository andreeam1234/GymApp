@model CreateGymClassViewModel
@{
    ViewData["Title"] = "Clasa noua";
}

<h2 class="mb-4">Adauga o clasa noua</h2>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-controller="GymClasses" asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="DurationMinutes" class="form-label"></label>
            <input asp-for="DurationMinutes" type="number" class="form-control" />
            <span asp-validation-for="DurationMinutes" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Category" class="form-label"></label>
            <select asp-for="Category" class="form-select">
                <option value="">-- Alege categoria --</option>
                <option value="Cardio">Cardio</option>
                <option value="Strength">Strength</option>
                <option value="Flexibility">Flexibility</option>
            </select>
            <span asp-validation-for="Category" class="text-danger"></span>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Salveaza</button>
    <a asp-controller="GymClasses" asp-action="Index" class="btn btn-link">Anuleaza</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
